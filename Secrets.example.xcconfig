// Template for MyHealthKit/Secrets.xcconfig (which is gitignored).
// Setup: cp Secrets.example.xcconfig MyHealthKit/Secrets.xcconfig, then fill in real values.
// The build fails without MyHealthKit/Secrets.xcconfig — Xcode uses it as the base configuration.

// Google Cloud Console → Places API (New); restrict the key to this app's bundle ID.
GOOGLE_PLACES_API_KEY =

// Ollama server as host:port, no scheme — xcconfig treats // as a comment start.
// Simulator: localhost:11434. Physical device: your Mac's LAN IP (`ipconfig getifaddr en0`).
OLLAMA_HOST = localhost:11434
OLLAMA_MODEL = llama3.1:8b
